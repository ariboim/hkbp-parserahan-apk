rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isRootAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'bca.ccpl@gmail.com';
    }

    function isAdmin() {
      return isRootAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAspirationCreate(data) {
      return data.keys().hasAll(['senderName', 'weyk', 'subject', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['senderName', 'weyk', 'subject', 'message', 'status', 'createdAt', 'authorUid']) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        data.weyk is string && data.weyk.size() >= 1 && data.weyk.size() <= 100 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 100 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 1500 &&
        data.status is string && data.status == 'Baru' &&
        data.createdAt == request.time &&
        (!('authorUid' in data) || (
          isSignedIn() &&
          data.authorUid is string &&
          data.authorUid.size() >= 1 &&
          data.authorUid.size() <= 128 &&
          data.authorUid == request.auth.uid
        ));
    }

    function isValidAspirationUpdate(data, prev) {
      return data.keys().hasAll(['senderName', 'weyk', 'subject', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['senderName', 'weyk', 'subject', 'message', 'status', 'adminNote', 'authorUid', 'createdAt', 'updatedAt']) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
        data.weyk is string && data.weyk.size() >= 1 && data.weyk.size() <= 100 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 100 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 1500 &&
        data.senderName == prev.senderName &&
        data.weyk == prev.weyk &&
        data.subject == prev.subject &&
        data.message == prev.message &&
        data.createdAt == prev.createdAt &&
        (!('authorUid' in prev) ? !('authorUid' in data) : ('authorUid' in data && data.authorUid == prev.authorUid)) &&
        data.status is string && data.status in ['Baru', 'Dibaca', 'Ditindaklanjuti', 'Selesai'] &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500)) &&
        data.updatedAt == request.time;
    }

    function isValidAdminUserCreate(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'name', 'role', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.role is string && data.role == 'Admin Utama (Ketua)' &&
        data.createdAt == request.time;
    }

    function isValidAdminUserUpdate(data, prev) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'name', 'role', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.role is string && data.role == 'Admin Utama (Ketua)' &&
        data.createdAt == prev.createdAt;
    }

    function isValidLiveStream(data) {
      return data.keys().hasAll(['title', 'speaker', 'scheduleIso', 'streamUrl', 'description', 'isLive', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'speaker', 'scheduleIso', 'streamUrl', 'description', 'isLive', 'updatedAt']) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 140 &&
        data.speaker is string && data.speaker.size() >= 2 && data.speaker.size() <= 120 &&
        data.scheduleIso is string && data.scheduleIso.size() >= 10 && data.scheduleIso.size() <= 40 &&
        data.streamUrl is string && data.streamUrl.size() >= 8 && data.streamUrl.size() <= 500 &&
        data.streamUrl.matches('^https://.*') &&
        data.description is string && data.description.size() <= 600 &&
        data.isLive is bool &&
        data.updatedAt == request.time;
    }

    function isValidLiveMessageCreate(data) {
      return data.keys().hasAll(['streamId', 'senderName', 'location', 'message', 'isAdmin', 'createdAt']) &&
        data.keys().hasOnly(['streamId', 'senderName', 'location', 'message', 'isAdmin', 'createdAt']) &&
        data.streamId is string && data.streamId == 'current' &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 80 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
        data.isAdmin is bool &&
        (data.isAdmin == false || isAdmin()) &&
        data.createdAt == request.time;
    }

    function isValidWijkMemberCreate(data) {
      return data.keys().hasAll(['rhjNumber', 'memberName', 'spouseName', 'childrenNames', 'address', 'whatsappNumber', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['rhjNumber', 'memberName', 'spouseName', 'childrenNames', 'address', 'whatsappNumber', 'createdAt', 'updatedAt']) &&
        data.rhjNumber is string && data.rhjNumber.size() >= 1 && data.rhjNumber.size() <= 50 &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 100 &&
        data.spouseName is string && data.spouseName.size() <= 100 &&
        data.childrenNames is string && data.childrenNames.size() <= 300 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 5 && data.whatsappNumber.size() <= 30 &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidWijkMemberUpdate(data, prev) {
      return data.keys().hasAll(['rhjNumber', 'memberName', 'spouseName', 'childrenNames', 'address', 'whatsappNumber', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['rhjNumber', 'memberName', 'spouseName', 'childrenNames', 'address', 'whatsappNumber', 'createdAt', 'updatedAt']) &&
        data.rhjNumber is string && data.rhjNumber.size() >= 1 && data.rhjNumber.size() <= 50 &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 100 &&
        data.spouseName is string && data.spouseName.size() <= 100 &&
        data.childrenNames is string && data.childrenNames.size() <= 300 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 5 && data.whatsappNumber.size() <= 30 &&
        data.createdAt == prev.createdAt &&
        data.updatedAt == request.time;
    }

    match /aspirations/{aspirationId} {
      allow get: if isValidId(aspirationId) && (
        isAdmin() ||
        (isSignedIn() && 'authorUid' in existing() && existing().authorUid == request.auth.uid)
      );
      allow list: if isRootAdmin() || (
        isSignedIn() && 'authorUid' in existing() && existing().authorUid == request.auth.uid
      );
      allow create: if isValidId(aspirationId) && isValidAspirationCreate(incoming());
      allow update: if isAdmin() &&
        isValidId(aspirationId) &&
        isValidAspirationUpdate(incoming(), existing()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(aspirationId);
    }

    match /admins/{adminUid} {
      allow get: if isAdmin() && isValidId(adminUid);
      allow list: if isRootAdmin();
      allow create: if isRootAdmin() && isValidId(adminUid) && isValidAdminUserCreate(incoming());
      allow update: if isRootAdmin() &&
        isValidId(adminUid) &&
        isValidAdminUserUpdate(incoming(), existing()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'name', 'role']);
      allow delete: if isRootAdmin() && isValidId(adminUid);
    }

    match /livestream/{streamId} {
      allow get: if isValidId(streamId) && streamId == 'current';
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(streamId) && streamId == 'current' && isValidLiveStream(incoming());
      allow delete: if isAdmin() && isValidId(streamId);
    }

    match /livestream_messages/{messageId} {
      allow get: if isValidId(messageId);
      allow list: if existing().streamId == 'current';
      allow create: if isValidId(messageId) && isValidLiveMessageCreate(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(messageId);
    }

    match /wijk_members/{memberId} {
      allow get: if isAdmin() && isValidId(memberId);
      allow list: if isRootAdmin();
      allow create: if isAdmin() && isValidId(memberId) && isValidWijkMemberCreate(incoming());
      allow update: if isAdmin() &&
        isValidId(memberId) &&
        isValidWijkMemberUpdate(incoming(), existing()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['rhjNumber', 'memberName', 'spouseName', 'childrenNames', 'address', 'whatsappNumber', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(memberId);
    }
  }
}
